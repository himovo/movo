# Optional public port and canonical enterprise URL.
MOVO_PORT=3000
# Separate browser origin for DSH plugin pages. Use a unique port per MOVO deployment.
MOVO_PLUGIN_UI_PORT=3100
# Physical Docker volume prefix. Keep this stable after the first startup.
MOVO_VOLUME_PREFIX=movo
# Official prebuilt images. Override only when using a private registry.
MOVO_IMAGE_PREFIX=ghcr.io/himovo/movo
# Pin a release in production, for example v0.1.0. Defaults to latest.
MOVO_VERSION=latest
# Legacy compatibility only: ASKAI_PORT is still accepted when MOVO_PORT is unset.
PUBLIC_BASE_URL=

# Container isolation is enabled by default for new deployments.
COMPOSE_PROFILES=sandbox
MOVO_SANDBOX_MANAGER_URL=http://sandbox-manager:8300
# MOVO_SANDBOX_MAX_CONCURRENT=2
# MOVO_SANDBOX_MAX_PENDING=8
# MOVO_SANDBOX_PLUGIN_IDLE_SECONDS=900
# Optional for source builds when the default Python package index is slow.
# MOVO_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# MOVO_APT_MIRROR=https://mirrors.aliyun.com
# MOVO_NPM_REGISTRY=https://registry.npmmirror.com
# Optional Skill dependency source preference for direct docker compose deployments.
# MOVO_DEPENDENCY_MIRROR=cn
# Optional time limits in seconds for each dependency command and the whole preparation.
# MOVO_SKILL_DEPENDENCY_STEP_TIMEOUT=480
# MOVO_SKILL_DEPENDENCY_BUILD_TIMEOUT=1800
# Extra attempts after trying the preferred and alternate sources (0-2).
# MOVO_SKILL_DEPENDENCY_RETRIES=1

# Required only when enabling knowledge-document embedding and reranking.
AZURE_EMBEDDING_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large
AZURE_EMBEDDING_API_VERSION=2024-02-01
AZURE_EMBEDDING_API_KEY=
DASHSCOPE_API_KEY=
