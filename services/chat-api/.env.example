PROJECT_NAME=MOVO Platform
API_V1_STR=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Runtime
DEBUG=false
LOG_LEVEL=INFO
LOG_FILE_ENABLED=false
LOG_FILE_PATH=backend.log
LOG_FILE_FORMAT=json
LOG_CONSOLE_PRETTY=true
LOG_CAPTURE_PRINTS=true
LOG_DEBUG_PAYLOADS=false
LOG_REQUEST_HEARTBEAT_SECONDS=15
LOG_SLOW_SPAN_MS=10000
LLM_SLOW_MS=30000
TOOL_SLOW_MS=20000
DB_SLOW_MS=3000
PRESENTATION_PAGE_SLOW_MS=20000
DEBUG_ARTIFACTS_ENABLED=false
DEBUG_ARTIFACT_RETENTION_DAYS=7
REQUEST_DEBUG_SNAPSHOT_ENABLED=false
ENABLE_BROWSER_PLANNING=true
ENABLE_CODING_PLANNING=true
PLAN_ONLY_MODE=false
PIPELINE_MODE=task_network
USE_MOCK_DATA=false

# Upload limits
MAX_UPLOAD_IMAGE_BYTES=52428800
MAX_UPLOAD_DOCUMENT_BYTES=209715200
MAX_UPLOAD_SKILL_SOURCE_BYTES=209715200
MAX_UPLOAD_TEMPLATE_BYTES=209715200

# OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MODEL_CHAT=gpt-5.2-chat
OPENAI_MODEL_GENERAL=gpt-5.2
OPENAI_MODEL_CODING=gpt-5.3-codex

# Azure OpenAI
USE_AZURE=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2023-05-15
AZURE_DEPLOYMENT_NAME=
AZURE_DEPLOYMENT_CHAT=
AZURE_DEPLOYMENT_GENERAL=
AZURE_DEPLOYMENT_CODING=

# Qwen / DashScope
USE_QWEN=false
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
USE_MULTIMODAL=true
DASHSCOPE_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3-vl-plus
VISION_ENABLE_THINKING=true
VISION_THINKING_BUDGET=81920

# Search / parser integrations
CRAWLER_API_URL=http://localhost:8000/crawler
DOC_PARSER_API_URL=
TOKEN_USAGE_PUSH_ENABLED=false
TOKEN_USAGE_PUSH_URL=
TOKEN_USAGE_PUSH_TIMEOUT_SECONDS=2.0
TOKEN_USAGE_QUEUE_SIZE=512
SERPAPI_API_KEY=
SERPAPI_ENABLED=false
SERPER_API_KEY=
TAVILY_API_KEY=
BAIDU_QIANFAN_API_KEY=
BAIDU_QIANFAN_SEARCH_URL=https://qianfan.baidubce.com/v2/ai_search/web_search
ARK_API_KEY=
ARK_BOT_MODEL=
ARK_BOT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/bots

# Data providers
TUSHARE_TOKEN=
TIANYANCHA_TOKEN=

# MongoDB
MONGODB_URI=
MONGODB_DB=gragentic
# Required for direct source development. Docker deployment generates these.
END_USER_AUTH_SECRET=
ADMIN_BACKEND_SERVICE_TOKEN=
ENABLE_DEMO_ENDPOINTS=false

# Sandbox
SANDBOX_PROVIDER=local
ALIYUN_ACCOUNT_ID=
ALIYUN_AIO_API_KEY=
ALIYUN_AIO_REGION=cn-hangzhou
ALIYUN_AIO_TEMPLATE_NAME=
ALIYUN_AIO_WS_AUTHORIZATION=
ALIYUN_AIO_REQUIRE_BROWSER_TEMPLATE=true

# Object storage
# oss keeps the existing enterprise Aliyun OSS behavior. local writes artifacts
# under LOCAL_STORAGE_PATH and returns FILE_PUBLIC_PATH_PREFIX URLs for browser
# access. Keep FILE_PUBLIC_PATH_PREFIX=/askai-api/files when the frontend or
# gateway rewrites /askai-api to the backend /api prefix.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=storage
FILE_PUBLIC_BASE_URL=
FILE_PUBLIC_PATH_PREFIX=/askai-api/api/files
BACKEND_INTERNAL_BASE_URL=http://127.0.0.1:8000
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=movo-artifacts
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-beijing
OSS_SIGN_EXPIRE_SECONDS=3600
