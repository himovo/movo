{
  "template_id": "content_thank_you_dark_minimal",
  "family": "content",
  "name": "Thank You Dark Minimal",
  "purpose": "Minimal dark closing slide with a centered oversized thank-you message, one supporting line, a simple inline contact row, and a bottom-right deck pill.",
  "selection_summary": "Use when the presentation should close on a calm, premium dark frame with almost no extra decoration.",
  "best_for": [
    "dark deck closings",
    "minimal thank-you pages",
    "premium investor deck endings"
  ],
  "avoid_when": [
    "a photo or illustration should appear",
    "the closing page needs multiple CTA blocks"
  ],
  "recommended_item_range": "1 thank-you + 1 support line + 1 inline contact row",
  "preferred_slide_roles": [
    "closing",
    "thank_you",
    "contact"
  ],
  "layout_regions": [
    "canvas"
  ],
  "slots": [
    {
      "slot_id": "title",
      "component_type": "title",
      "region": "canvas",
      "style_role": "hero_title",
      "max_chars_cjk": 14,
      "max_chars_latin": 28
    },
    {
      "slot_id": "subtitle_or_context",
      "component_type": "subtitle",
      "region": "canvas",
      "style_role": "subtitle",
      "max_chars_cjk": 18,
      "max_chars_latin": 86
    },
    {
      "slot_id": "contact_line",
      "component_type": "subtitle",
      "region": "canvas",
      "style_role": "subtitle",
      "max_chars_cjk": 18,
      "max_chars_latin": 61
    },
    {
      "slot_id": "deck_label",
      "component_type": "subtitle",
      "region": "canvas",
      "style_role": "subtitle",
      "max_chars_cjk": 8,
      "max_chars_latin": 17
    }
  ],
  "layout_rules": [
    "Keep everything centered except the deck pill.",
    "The contact line should remain compact and quiet beneath the support line."
  ],
  "background_policy": "dark_gradient",
  "preview_content": {
    "title": "Thank you.",
    "subtitle_or_context": "Thank you for taking the time to read this. Your attention and engagement mean a lot.",
    "contact_line": "hello@example.com | +1 (555) 555-0123 | example.com",
    "deck_label": "Pitch deck"
  },
