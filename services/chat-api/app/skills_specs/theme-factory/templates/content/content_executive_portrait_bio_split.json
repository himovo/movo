  "selection_summary": "Use when one executive or customer spokesperson should be introduced through a portrait and one attributed statement block.",
  "best_for": [
    "executive endorsements",
    "customer proof with named speaker",
    "leader spotlight slides"
  ],
  "avoid_when": [
    "the quote should dominate more than the portrait",
    "multiple people must fit"
