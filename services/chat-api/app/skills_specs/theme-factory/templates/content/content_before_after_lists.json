{
  "template_id": "content_before_after_lists",
  "family": "content",
  "name": "Before After Lists",
  "purpose": "Two-column comparison with stacked list pills for before vs. after states and a large bottom headline.",
  "selection_summary": "Use when two opposing states need to be contrasted through short list items rather than a formal table.",
  "best_for": [
    "before and after framing",
    "status quo vs. future state",
    "problem to solution narratives"
  ],
  "avoid_when": [
    "more than two states must be shown",
    "a detailed comparison matrix is required"
  ],
  "recommended_item_range": "2 fixed comparison labels + 2 short lists + 1 bottom headline",
