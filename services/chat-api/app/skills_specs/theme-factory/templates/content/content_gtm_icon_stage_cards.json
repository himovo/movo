{
  "template_id": "content_gtm_icon_stage_cards",
  "family": "content",
  "name": "GTM Icon Stage Cards",
  "purpose": "Horizontal launch-growth-scale composition with three large icon stage cards connected by a central line and anchored by a bottom headline plus summary copy.",
  "selection_summary": "Use when three market-entry stages should feel iconic and poster-like rather than text-heavy.",
  "best_for": [
    "three-stage GTM pages",
    "launch-growth-scale framing",
    "poster-like strategy slides"
  ],
  "avoid_when": [
    "the narrative needs long descriptions",
    "more than three stages are required"
  ],
  "recommended_item_range": "3 stage icons + 1 headline + 1 short summary paragraph",
  "layout_regions": [
    "canvas"
  ],
  "slots": [
    {
      "slot_id": "stage_cards",
      "component_type": "bullet_list",
      "region": "canvas",
      "style_role": "surface_primary",
      "max_items": 3,
      "item_fields": [
        {
          "field_name": "icon",
          "field_type": "icon",
          "required": false,
          "max_chars_cjk": 0,
          "max_chars_latin": 0
        },
        {
          "field_name": "meta",
          "field_type": "meta",
          "required": true,
          "max_chars_cjk": 6,
          "max_chars_latin": 8
        },
        {
          "field_name": "title",
          "field_type": "text",
          "required": true,
          "max_chars_cjk": 12,
          "max_chars_latin": 28
        }
      ],
      "max_chars_cjk": 12,
      "max_chars_latin": 28
    },
    {
      "slot_id": "title",
      "component_type": "title",
      "region": "canvas",
      "style_role": "hero_title",
      "max_chars_cjk": 14,
      "max_chars_latin": 37
    },
    {
      "slot_id": "subtitle_or_context",
      "component_type": "subtitle",
      "region": "canvas",
      "style_role": "subtitle",
      "max_chars_cjk": 18,
      "max_chars_latin": 102
    }
  ],
  "layout_rules": [
    "The three stages should sit on a single connected track.",
    "Stage labels should stay concise and uppercase."
  ],
  "background_policy": "light_gradient_with_subtle_grid",
