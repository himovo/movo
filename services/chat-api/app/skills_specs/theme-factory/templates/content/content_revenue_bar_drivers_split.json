{
  "template_id": "content_revenue_bar_drivers_split",
  "family": "content",
  "name": "Revenue Bar Drivers Split",
  "purpose": "Performance slide with a left three-bar revenue chart and a right stack of driver cards explaining the growth inputs.",
  "selection_summary": "Use when revenue growth should be paired with the specific business drivers behind it.",
  "best_for": [
    "growth analysis",
    "revenue drivers",
    "board update slides"
  ],
  "avoid_when": [
    "many years or series must be charted",
