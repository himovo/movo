          "required": true,
          "max_chars_cjk": 28,
          "max_chars_latin": 72
        }
      ],
      "max_chars_cjk": 12,
      "max_chars_latin": 35
    }
  ],
  "layout_rules": [
    "Keep the left visual as a simple chart placeholder or chart graphic.",
    "Driver cards should align vertically on the right and stay concise."
  ],
  "background_policy": "light_gradient",
