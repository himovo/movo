{
  "template_id": "content_competitor_logo_grid_portrait",
  "family": "content",
  "name": "Competitor Grid With Portrait",
  "purpose": "Half-and-half layout with a four-card competitor badge grid on the left and a full-height portrait placeholder on the right.",
  "selection_summary": "Use when the comparison should feel human and editorial, pairing brand icons with a dominant portrait image.",
  "best_for": [
    "competitor landscape pages",
    "brand comparison with customer context",
    "portrait-led market slides"
  ],
  "avoid_when": [
    "no portrait visual is available",
    "the slide needs detailed tabular evidence"
  ],
  "recommended_item_range": "4 badge cards + 1 portrait placeholder",
  "layout_regions": [
    "canvas"
  ],
  "slots": [
    {
      "slot_id": "badge_cards",
      "component_type": "bullet_list",
      "region": "canvas",
      "style_role": "surface_primary",
