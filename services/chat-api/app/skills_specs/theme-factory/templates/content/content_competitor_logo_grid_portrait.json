      "item_fields": [
        {
          "field_name": "icon",
          "field_type": "icon",
          "required": false,
          "max_chars_cjk": 0,
          "max_chars_latin": 0
        },
        {
          "field_name": "title",
          "field_type": "text",
          "required": true,
          "max_chars_cjk": 12,
          "max_chars_latin": 24
        },
        {
          "field_name": "body",
          "field_type": "body",
          "required": true,
          "max_chars_cjk": 26,
          "max_chars_latin": 56
        }
      ],
      "max_chars_cjk": 12,
      "max_chars_latin": 24
    },
    {
      "slot_id": "hero_visual",
      "component_type": "generic_diagram",
      "region": "canvas",
      "style_role": "surface_secondary"
    }
  ],
  "layout_rules": [
    "The left grid should be compact and brand-like.",
    "The right portrait should fill the full image panel."
  ],
  "background_policy": "light_gradient",
