{
  "template_id": "content_process_cards_band",
  "family": "content",
  "name": "Process Cards Over Band",
  "purpose": "Four-step process cards floating over a horizontal lower band with a centered supporting statement beneath.",
  "selection_summary": "Use when a compact, equal-step transformation flow needs to sit above one summarizing statement.",
  "best_for": [
    "process summaries",
    "transformation flows",
    "AI workflow overviews"
  ],
  "avoid_when": [
    "steps need detailed explanatory text",
    "a timeline chart would be clearer"
  ],
  "recommended_item_range": "1 eyebrow + 1 headline + 4 process cards + 1 summary line",
  "layout_regions": [
    "canvas"
  ],
  "slots": [
    {
      "slot_id": "eyebrow",
      "component_type": "subtitle",
      "region": "canvas",
      "style_role": "subtitle",
      "max_chars_cjk": 8,
      "max_chars_latin": 22
    },
    {
      "slot_id": "title",
      "component_type": "title",
      "region": "canvas",
      "style_role": "hero_title",
      "max_chars_cjk": 14,
      "max_chars_latin": 39
    },
    {
      "slot_id": "process_cards",
      "component_type": "bullet_list",
      "region": "canvas",
      "style_role": "surface_primary",
      "max_items": 4,
      "item_fields": [
        {
          "field_name": "icon",
          "field_type": "icon",
          "required": false,
          "max_chars_cjk": 0,
          "max_chars_latin": 0
        },
        {
          "field_name": "title",
          "field_type": "text",
          "required": true,
          "max_chars_cjk": 10,
          "max_chars_latin": 29
        },
        {
          "field_name": "body",
          "field_type": "body",
          "required": true,
          "max_chars_cjk": 18,
          "max_chars_latin": 58
        }
      ],
      "max_chars_cjk": 10,
      "max_chars_latin": 29
    },
    {
      "slot_id": "subtitle_or_context",
      "component_type": "subtitle",
      "region": "canvas",
      "style_role": "subtitle",
      "max_chars_cjk": 18,
      "max_chars_latin": 98
    }
  ],
  "layout_rules": [
    "The four cards should sit in one row above the lower band.",
    "Use the supporting statement as a centered explanatory footer."
  ],
  "background_policy": "light_gradient",
  "preview_content": {
