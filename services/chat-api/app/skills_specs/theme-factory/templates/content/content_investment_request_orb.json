{
  "template_id": "content_investment_request_orb",
  "family": "content",
  "name": "Investment Request Orb",
  "purpose": "Minimal ask slide anchored by one giant central circular orb containing the stage label, funding amount, and short ask statement.",
  "selection_summary": "Use when one investment ask or headline metric should dominate the entire slide.",
  "best_for": [
    "fundraising ask slides",
    "single-metric emphasis",
    "round-number request pages"
  ],
  "avoid_when": [
    "multiple metrics must fit",
    "supporting details need more space"
  ],
  "recommended_item_range": "1 stage pill + 1 dominant amount + 1 short request statement",
  "layout_regions": [
    "canvas"
  ],
  "slots": [
    {
      "slot_id": "stage_label",
      "component_type": "subtitle",
      "region": "canvas",
      "style_role": "subtitle",
      "max_chars_cjk": 8,
      "max_chars_latin": 16
    },
    {
      "slot_id": "ask_value",
      "component_type": "title",
      "region": "canvas",
      "style_role": "hero_title",
      "max_chars_cjk": 14,
      "max_chars_latin": 28
    },
    {
      "slot_id": "ask_statement",
      "component_type": "subtitle",
      "region": "canvas",
      "style_role": "subtitle",
      "max_chars_cjk": 18,
      "max_chars_latin": 85
    },
    {
      "slot_id": "footer_left",
      "component_type": "subtitle",
      "region": "canvas",
      "style_role": "subtitle",
      "max_chars_cjk": 18,
      "max_chars_latin": 40
    }
  ],
  "layout_rules": [
    "The orb should occupy the visual center and dominate the page.",
    "Supporting copy must remain short and inside the circle."
  ],
  "background_policy": "light_gradient",
  "preview_content": {
    "stage_label": "Stage 1",
    "ask_value": "$5M",
    "ask_statement": "We are seeking $5M to accelerate the mission of delivering adaptive AI solutions.",
    "footer_left": "Investment request"
  },
