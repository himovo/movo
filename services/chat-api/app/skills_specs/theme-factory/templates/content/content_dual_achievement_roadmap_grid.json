  "family": "content",
  "name": "Dual Achievement Roadmap Grid",
  "purpose": "Wide top statement with two labeled halves beneath, each containing a balanced 2x2 grid of cards for past achievements versus future roadmap items.",
  "selection_summary": "Use when the slide should contrast what has already been achieved against what comes next in a clean symmetric layout.",
  "best_for": [
    "past vs future framing",
    "milestone recaps",
    "roadmap transition slides"
  ],
  "avoid_when": [
    "the two sides are not equally weighted",
    "a timeline would be more natural"
  ],
  "recommended_item_range": "1 headline + 2 section labels + 8 cards",
