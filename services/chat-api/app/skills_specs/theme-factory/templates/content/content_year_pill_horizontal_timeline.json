{
  "template_id": "content_year_pill_horizontal_timeline",
  "family": "content",
  "name": "Year Pill Horizontal Timeline",
  "purpose": "Light roadmap slide with a top-left framing line, a thin horizontal connector, and four floating year pills with milestone descriptions beneath.",
  "selection_summary": "Use when a multi-year plan should be shown as a light editorial timeline with year chips rather than large circles.",
  "best_for": [
    "roadmaps",
    "GTM sequencing",
    "4-year rollout plans"
  ],
  "avoid_when": [
    "milestones require many subpoints",
    "the page should feel dense and analytical"
  ],
  "recommended_item_range": "1 eyebrow + 1 headline + 4 year milestones",
