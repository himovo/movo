        {
          "field_name": "body",
          "field_type": "body",
          "required": true,
          "max_chars_cjk": 28,
          "max_chars_latin": 70
        }
      ],
      "max_chars_cjk": 12,
      "max_chars_latin": 42
    }
  ],
  "layout_rules": [
    "Use one thin horizontal line that runs through the center of the year pills.",
    "Descriptions should sit directly beneath each milestone."
  ],
  "background_policy": "light_gradient",
