{
  "template_id": "content_thank_you_blue_banner",
  "family": "content",
  "name": "Thank You Blue Banner",
  "purpose": "Closing slide with a large blue hero banner on top, a big white thank-you headline, a supporting paragraph beneath, and two contact cards anchored in the lower area.",
  "selection_summary": "Use when the closing slide should feel bright, optimistic, and brand-forward without using a photo.",
  "best_for": [
    "brand-led closing slides",
    "thank-you pages with compact contact methods",
    "light decks needing a bold closing top band"
  ],
  "avoid_when": [
    "a full image panel is needed",
    "the ending should remain minimal and quiet"
  ],
  "recommended_item_range": "1 hero thank-you + 1 supporting paragraph + 2 contact cards",
  "preferred_slide_roles": [
    "closing",
    "thank_you",
    "contact"
  ],
  "layout_regions": [
    "canvas"
  ],
  "slots": [
    {
      "slot_id": "title",
      "component_type": "title",
      "region": "canvas",
      "style_role": "hero_title",
      "max_chars_cjk": 14,
      "max_chars_latin": 28
    },
    {
      "slot_id": "subtitle_or_context",
      "component_type": "subtitle",
      "region": "canvas",
      "style_role": "subtitle",
      "max_chars_cjk": 18,
      "max_chars_latin": 86
    },
    {
      "slot_id": "contact_cards",
      "component_type": "bullet_list",
      "region": "canvas",
      "style_role": "surface_primary",
      "max_items": 2,
      "item_fields": [
        {
          "field_name": "icon",
          "field_type": "icon",
          "required": false,
          "max_chars_cjk": 0,
          "max_chars_latin": 0
        },
        {
          "field_name": "title",
          "field_type": "text",
          "required": true,
          "max_chars_cjk": 12,
          "max_chars_latin": 27
        }
      ],
      "max_chars_cjk": 12,
      "max_chars_latin": 27
    }
  ],
  "layout_rules": [
    "The top banner should occupy the full width and carry the hero message.",
    "Contact cards should sit near the lower-left area and remain compact."
  ],
  "background_policy": "light_gradient",
  "preview_content": {
    "title": "Thank you.",
    "subtitle_or_context": "Thank you for taking the time to read this. Your attention and engagement mean a lot.",
    "contact_cards": [
      {
        "icon": "chat",
        "title": "hello@example.com"
      },
      {
        "icon": "clock",
        "title": "+1 (555) 555-0123"
      }
    ]
  },
