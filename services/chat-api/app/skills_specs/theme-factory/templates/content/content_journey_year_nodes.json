{
  "template_id": "content_journey_year_nodes",
  "family": "content",
  "name": "Journey Year Nodes",
  "purpose": "Five-point horizontal journey timeline with evenly spaced year nodes connected by one line and concise explanatory captions beneath.",
  "selection_summary": "Use when a company's journey should be shown as five chronological steps across one clean horizontal track.",
  "best_for": [
    "company journey",
    "milestone timelines",
    "what is next framing"
  ],
  "avoid_when": [
    "events need long detail",
    "the slide should compare two different paths"
  ],
  "recommended_item_range": "1 headline + 5 year nodes",
  "layout_regions": [
    "canvas"
  ],
  "slots": [
    {
      "slot_id": "title",
      "component_type": "title",
      "region": "canvas",
      "style_role": "hero_title",
      "max_chars_cjk": 14,
      "max_chars_latin": 36
    },
    {
      "slot_id": "journey_cards",
      "component_type": "bullet_list",
      "region": "canvas",
      "style_role": "surface_primary",
      "max_items": 5,
      "item_fields": [
        {
          "field_name": "meta",
          "field_type": "meta",
          "required": true,
          "max_chars_cjk": 6,
          "max_chars_latin": 8
        },
        {
          "field_name": "title",
          "field_type": "text",
          "required": true,
          "max_chars_cjk": 12,
          "max_chars_latin": 28
        },
        {
          "field_name": "body",
          "field_type": "body",
          "required": true,
          "max_chars_cjk": 28,
          "max_chars_latin": 67
        }
      ],
      "max_chars_cjk": 12,
      "max_chars_latin": 28
    }
  ],
  "layout_rules": [
    "The headline should sit above the center of the line.",
    "All year nodes should be equal in diameter and evenly distributed."
  ],
  "background_policy": "light_gradient",
  "preview_content": {
