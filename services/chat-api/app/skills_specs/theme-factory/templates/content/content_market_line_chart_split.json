          "max_chars_cjk": 6,
          "max_chars_latin": 9
        },
        {
          "field_name": "title",
          "field_type": "text",
          "required": true,
          "max_chars_cjk": 12,
          "max_chars_latin": 37
        },
        {
          "field_name": "body",
          "field_type": "body",
          "required": true,
          "max_chars_cjk": 28,
          "max_chars_latin": 64
        }
      ],
      "max_chars_cjk": 12,
      "max_chars_latin": 37
    },
    {
      "slot_id": "chart_data",
      "component_type": "generic_diagram",
      "region": "canvas",
      "style_role": "surface_primary"
    },
    {
      "slot_id": "eyebrow",
      "component_type": "subtitle",
      "region": "canvas",
      "style_role": "subtitle",
      "max_chars_cjk": 8,
      "max_chars_latin": 17
    }
  ],
  "layout_rules": [
    "Keep the left stack compact and the chart dominant.",
    "Use the eyebrow as a small projected label near the chart."
