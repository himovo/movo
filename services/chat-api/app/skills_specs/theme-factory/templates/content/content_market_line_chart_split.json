{
  "template_id": "content_market_line_chart_split",
  "family": "content",
  "name": "Market Split Line Chart",
  "purpose": "Market slide with stacked market labels on the left and a projection line chart dominating the right.",
  "selection_summary": "Use when three market layers need to be explained with a directional projection visual rather than static circles.",
  "best_for": [
    "market projections",
    "growth expectation slides",
    "TAM SAM SOM with trend lines"
  ],
  "avoid_when": [
    "no projection data is available",
    "the slide should stay purely categorical"
  ],
  "recommended_item_range": "3 market labels + 1 chart + 1 growth footnote",
  "layout_regions": [
    "canvas"
  ],
  "slots": [
    {
      "slot_id": "market_cards",
      "component_type": "bullet_list",
      "region": "canvas",
      "style_role": "surface_secondary",
      "max_items": 3,
      "item_fields": [
        {
          "field_name": "meta",
          "field_type": "meta",
