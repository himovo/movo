{
  "template_id": "content_glow_icon_statement",
  "family": "content",
  "name": "Glow Icon Statement",
  "purpose": "Left-aligned statement layout paired with a large glowing icon orb as the primary visual anchor.",
  "selection_summary": "Use when the message is simple, bold, and supported by one symbolic hero mark rather than detailed product imagery.",
  "best_for": [
    "vision statements",
    "brand positioning slides",
    "symbol-led AI messaging"
  ],
  "avoid_when": [
    "the slide needs detailed screenshots",
    "multiple data points must fit on the page"
  ],
  "recommended_item_range": "1 eyebrow + 1 headline + 1 paragraph + 1 hero icon orb",
