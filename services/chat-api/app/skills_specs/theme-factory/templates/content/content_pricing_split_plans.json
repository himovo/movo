{
  "template_id": "content_pricing_split_plans",
  "family": "content",
  "name": "Pricing Split Plans",
  "purpose": "Centered pricing page with one eyebrow, one large headline, and three plan cards arranged side by side with an emphasized middle tier.",
  "selection_summary": "Use when three pricing tiers should be presented as a clean pricing table with one featured plan in the center.",
  "best_for": [
    "pricing pages",
    "plan tier overviews",
    "commercial packaging slides"
  ],
  "avoid_when": [
    "the slide needs dense feature comparison tables",
    "there are more than three core plans"
  ],
  "recommended_item_range": "1 eyebrow + 1 headline + 3 plan cards",
  "layout_regions": [
    "canvas"
  ],
  "slots": [
    {
      "slot_id": "eyebrow",
      "component_type": "subtitle",
      "region": "canvas",
      "style_role": "subtitle",
      "max_chars_cjk": 8,
      "max_chars_latin": 18
    },
    {
      "slot_id": "title",
      "component_type": "title",
      "region": "canvas",
      "style_role": "hero_title",
      "max_chars_cjk": 14,
      "max_chars_latin": 43
    },
    {
      "slot_id": "plan_cards",
      "component_type": "bullet_list",
      "region": "canvas",
      "style_role": "surface_primary",
      "max_items": 3,
      "item_fields": [
        {
          "field_name": "kicker",
          "field_type": "text",
          "required": true,
          "max_chars_cjk": 12,
          "max_chars_latin": 28
        },
        {
          "field_name": "price",
          "field_type": "meta",
          "required": false,
          "max_chars_cjk": 6,
          "max_chars_latin": 8
        },
        {
          "field_name": "unit",
          "field_type": "text",
          "required": false,
          "max_chars_cjk": 12,
          "max_chars_latin": 28
        },
        {
          "field_name": "features",
          "field_type": "text",
          "required": true,
          "max_chars_cjk": 12,
          "max_chars_latin": 64
        },
        {
          "field_name": "badge",
          "field_type": "text",
          "required": false,
          "max_chars_cjk": 12,
          "max_chars_latin": 28
        },
        {
          "field_name": "featured",
          "field_type": "text",
          "required": false,
          "max_chars_cjk": 12,
          "max_chars_latin": 28
        },
        {
          "field_name": "subtitle",
          "field_type": "body",
          "required": false,
          "max_chars_cjk": 28,
          "max_chars_latin": 64
        }
      ]
    }
  ],
  "layout_rules": [
    "Keep the eyebrow and title centered above the pricing cards.",
    "Use the center card as the visually featured tier.",
    "Each card should keep pricing, optional badge, and features clearly separated."
  ],
  "background_policy": "dark_clean",
  "preview_content": {
    "eyebrow": "Our Pricing",
    "title": "Flexible pricing for every business",
    "plan_cards": [
