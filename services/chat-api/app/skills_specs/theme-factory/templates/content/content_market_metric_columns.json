{
  "template_id": "content_market_metric_columns",
  "family": "content",
  "name": "Market Metric Columns",
  "purpose": "Centered market landscape slide with one large title and three evenly divided metric columns beneath.",
  "selection_summary": "Use when market sizes should read like a structured editorial table instead of circles or charts.",
  "best_for": [
    "market landscape summaries",
    "three-column size snapshots",
    "clean investor-style market pages"
  ],
  "avoid_when": [
    "visual symbolism matters more than clarity",
    "more than three market segments are required"
  ],
  "recommended_item_range": "1 eyebrow + 1 headline + 3 metric columns",
  "layout_regions": [
    "canvas"
  ],
  "slots": [
    {
      "slot_id": "eyebrow",
      "component_type": "subtitle",
      "region": "canvas",
      "style_role": "subtitle",
      "max_chars_cjk": 8,
      "max_chars_latin": 25
    },
    {
      "slot_id": "title",
      "component_type": "title",
      "region": "canvas",
      "style_role": "hero_title",
      "max_chars_cjk": 14,
      "max_chars_latin": 39
    },
    {
      "slot_id": "market_cards",
      "component_type": "bullet_list",
      "region": "canvas",
      "style_role": "surface_primary",
      "max_items": 3,
      "item_fields": [
        {
          "field_name": "meta",
          "field_type": "meta",
          "required": true,
          "max_chars_cjk": 6,
          "max_chars_latin": 9
        },
        {
          "field_name": "title",
          "field_type": "text",
          "required": true,
          "max_chars_cjk": 10,
          "max_chars_latin": 37
        },
        {
          "field_name": "body",
          "field_type": "body",
          "required": true,
          "max_chars_cjk": 22,
          "max_chars_latin": 77
        }
      ],
      "max_chars_cjk": 10,
      "max_chars_latin": 37
    }
  ],
  "layout_rules": [
    "Use a strong horizontal divider between title and metrics.",
    "Each column should prioritize the value first."
  ],
  "background_policy": "light_gradient",
  "preview_content": {
    "eyebrow": "Market Opportunity",
