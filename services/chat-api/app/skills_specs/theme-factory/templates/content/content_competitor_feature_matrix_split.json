{
  "template_id": "content_competitor_feature_matrix_split",
  "family": "content",
  "name": "Competitor Feature Matrix Split",
  "purpose": "Two-panel competitor slide with a left brand stack and a right narrative plus feature comparison table.",
  "selection_summary": "Use when the slide should contrast three market players through a simple logo stack and a structured feature matrix.",
  "best_for": [
    "competitor comparison",
    "market positioning",
    "feature parity stories"
  ],
  "avoid_when": [
    "many competitors are involved",
    "detailed analytical commentary is required"
  ],
  "recommended_item_range": "1 left brand stack + 1 right headline block + 1 feature matrix",
  "layout_regions": [
    "canvas"
  ],
  "slots": [
    {
      "slot_id": "eyebrow",
      "component_type": "subtitle",
      "region": "canvas",
      "style_role": "subtitle",
      "max_chars_cjk": 8,
      "max_chars_latin": 19
    },
    {
      "slot_id": "brand_cards",
      "component_type": "bullet_list",
      "region": "canvas",
      "style_role": "surface_primary",
      "max_items": 3,
      "item_fields": [
        {
          "field_name": "icon",
          "field_type": "icon",
          "required": false,
          "max_chars_cjk": 0,
          "max_chars_latin": 0
        },
        {
          "field_name": "title",
          "field_type": "text",
          "required": true,
          "max_chars_cjk": 12,
          "max_chars_latin": 28
        },
        {
          "field_name": "body",
          "field_type": "body",
          "required": true,
          "max_chars_cjk": 28,
          "max_chars_latin": 64
        }
      ],
      "max_chars_cjk": 12,
      "max_chars_latin": 28
    },
    {
      "slot_id": "title",
      "component_type": "title",
      "region": "canvas",
      "style_role": "hero_title",
      "max_chars_cjk": 14,
      "max_chars_latin": 34
    },
    {
      "slot_id": "subtitle_or_context",
      "component_type": "subtitle",
      "region": "canvas",
      "style_role": "subtitle",
      "max_chars_cjk": 18,
      "max_chars_latin": 99
    },
    {
      "slot_id": "comparison_table",
      "component_type": "generic_diagram",
      "region": "canvas",
      "style_role": "surface_primary"
    }
  ],
  "layout_rules": [
    "The left side should feel like a competitor shelf rather than a data table.",
    "The right table should remain the primary evidence block."
  ],
  "background_policy": "light_gradient_with_subtle_grid",
  "preview_content": {
    "eyebrow": "Competitors",
    "title": "How the product stands out",
    "subtitle_or_context": "Compare core capabilities against two established alternatives using a clean, readable matrix.",
    "brand_cards": [
      {
        "icon": "growth",
        "title": "Competitor 1",
        "body": "Organization Tech"
      },
      {
        "icon": "spark",
        "title": "Competitor 2",
        "body": "Enterprise Suite"
      },
      {
        "icon": "brain",
        "title": "Our product",
        "body": "Adaptive AI platform"
      }
    ],
    "comparison_table": {
      "headers": [
        "Feature",
        "Competitor 1",
        "Competitor 2",
        "Our product"
      ],
      "rows": [
        [
          "AI-powered responses",
          "Yes",
          "Yes",
          "Yes"
        ],
        [
          "Context awareness",
          "No",
          "Yes",
          "Yes"
        ],
        [
          "CRM integrations",
          "No",
          "No",
          "Yes"
        ],
        [
          "Affordable pricing",
          "No",
          "Yes",
          "Yes"
        ]
      ]
    }
  },
