{
  "template_id": "content_quote_centered",
  "family": "content",
  "name": "Centered Testimonial Quote",
  "purpose": "Centered testimonial page with a circular avatar, oversized quote, and speaker attribution beneath.",
  "selection_summary": "Use when one customer quote should dominate the entire page and act as a proof-point centerpiece.",
  "best_for": [
    "testimonials",
    "customer proof quotes",
    "trust-building slides"
  ],
  "avoid_when": [
    "more than one quote is needed",
    "a side-by-side customer story would be stronger"
  ],
  "recommended_item_range": "1 avatar + 1 quote + 1 name + 1 role",
  "layout_regions": [
    "canvas"
  ],
  "slots": [
    {
      "slot_id": "hero_visual",
      "component_type": "generic_diagram",
      "region": "canvas",
      "style_role": "surface_secondary"
    },
    {
      "slot_id": "quote_text",
      "component_type": "statement",
      "region": "canvas",
      "style_role": "hero_title",
      "max_chars_cjk": 18,
      "max_chars_latin": 96
    },
    {
      "slot_id": "speaker_name",
      "component_type": "statement",
      "region": "canvas",
      "style_role": "subtitle",
      "max_chars_cjk": 18,
      "max_chars_latin": 40
    },
    {
      "slot_id": "speaker_role",
      "component_type": "statement",
      "region": "canvas",
      "style_role": "subtitle",
      "max_chars_cjk": 18,
      "max_chars_latin": 40
    }
  ],
  "layout_rules": [
    "The quote should be the only dominant text block.",
    "Avatar stays centered and small relative to the statement."
  ],
  "background_policy": "light_gradient_with_subtle_grid",
  "preview_content": {
    "hero_visual": "",
    "quote_text": "\"The system reduced response time by 60% and made support feel dramatically more consistent.\"",
    "speaker_name": "William Miller",
    "speaker_role": "CEO, NeuralWave Solutions"
  },
