{
  "template_id": "content_intro_badge_card",
  "family": "content",
  "name": "Intro Badge Card",
  "purpose": "Centered introductory card with a floating pill label, oversized single-word headline, and short body copy.",
  "selection_summary": "Use for chapter lead-ins where the page should feel framed and focused, with one clean content card in the center.",
  "best_for": [
    "chapter title slides",
    "single-idea introductions",
    "editorial emphasis pages"
  ],
  "avoid_when": [
    "multiple support blocks are needed",
    "a side-by-side composition would be clearer"
  ],
  "recommended_item_range": "1 pill + 1 headline + 1 supporting paragraph",
