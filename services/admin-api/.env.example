ASKAI_ADMIN_APP_ENV=development
ASKAI_ADMIN_MONGODB_URI=mongodb://127.0.0.1:27017
ASKAI_ADMIN_MONGODB_DB=gragentic
# Required for direct source development. Docker deployment generates this.
ASKAI_ADMIN_JWT_SECRET=
ASKAI_ADMIN_BACKEND_BASE_URL=http://127.0.0.1:8000
ASKAI_ADMIN_BACKEND_SERVICE_TOKEN=
ASKAI_ADMIN_BOOTSTRAP_ADMIN_ENABLED=false
ASKAI_ADMIN_BOOTSTRAP_ADMIN_USERNAME=admin
# Set only when explicitly enabling bootstrap administration for local development.
ASKAI_ADMIN_BOOTSTRAP_ADMIN_PASSWORD=
ASKAI_ADMIN_BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
ASKAI_ADMIN_BOOTSTRAP_ADMIN_ROLE_NAME=平台超级管理员
ASKAI_ADMIN_BOOTSTRAP_ADMIN_ORG_NAME=MOVO 平台
ASKAI_ADMIN_MODEL_TEST_CA_BUNDLE=
ASKAI_ADMIN_MODEL_TEST_INSECURE_SKIP_VERIFY=false
ASKAI_ADMIN_KNOWLEDGE_STORAGE_TYPE=local
ASKAI_ADMIN_KNOWLEDGE_LOCAL_STORAGE_DIR=data/knowledge-documents
ASKAI_ADMIN_KNOWLEDGE_MAX_UPLOAD_MB=200
ASKAI_ADMIN_KNOWLEDGE_OSS_ACCESS_KEY_ID=
ASKAI_ADMIN_KNOWLEDGE_OSS_ACCESS_KEY_SECRET=
ASKAI_ADMIN_KNOWLEDGE_OSS_PREFIX=knowledge-documents
ASKAI_ADMIN_DOCUMENT_PROCESSING_BASE_URL=http://127.0.0.1:8200
ASKAI_ADMIN_DOCUMENT_PROCESSING_SERVICE_TOKEN=
ASKAI_ADMIN_DOCUMENT_PROCESSING_CALLBACK_TOKEN=
ASKAI_ADMIN_ADMIN_API_PUBLIC_BASE_URL=http://127.0.0.1:8101
