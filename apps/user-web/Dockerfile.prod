FROM node:26-slim AS build

WORKDIR /app

ARG VITE_ADMIN_WEB_URL
ENV VITE_ADMIN_WEB_URL=$VITE_ADMIN_WEB_URL

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# Keep this runtime aligned with admin-web and gateway. The Debian/glibc variant
# avoids the Alpine musl pwritev2 path rejected by older container hosts.
FROM nginx:1.31.6-trixie

ARG MOVO_SECURITY_REFRESH=local
RUN test -n "${MOVO_SECURITY_REFRESH}" \
    && apt-get update \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
